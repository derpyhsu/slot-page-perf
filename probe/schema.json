{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-page-perf/evidence-1",
  "type": "object",
  "required": ["schemaVersion", "conditions", "channels", "stages", "spins", "memory", "findings", "coverage"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "example": { "type": "boolean" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "displayName": { "type": "string" },
        "urlPath": { "type": "string", "description": "Path only. Never include the query string." }
      }
    },
    "timeline": { "type": "object", "description": "Time series from summary().timeline. Bucket and long task field names are listed inside." },
    "cocos": {
      "type": "object",
      "properties": { "snapshots": { "type": "array", "description": "Results of __slotPerf.cocos() in stage order." } }
    },
    "summary": {
      "type": "object",
      "properties": { "smooth": { "type": "string" }, "memory": { "type": "string" } }
    },
    "issues": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["title", "next"],
        "properties": {
          "title": { "type": "string" },
          "stage": { "type": "string" },
          "t": { "type": ["number", "null"] },
          "level": { "enum": ["red", "orange", "yellow", "green"] },
          "area": { "type": "string", "description": "CPU, 記憶體, draw call, 穩定性, or 卡頓. Defaults to the stage name." },
          "rule": { "type": "string", "description": "A Cocos rule id from protocol/rules.md. Replaces that rule's generic row." },
          "next": { "type": "string" }
        }
      }
    },
    "missing": { "type": "array", "items": { "type": "string" } },
    "entry": {
      "type": "object",
      "description": "How the run got from loading to the first spin. See 進遊戲 in protocol/scenarios.md.",
      "properties": {
        "result": { "enum": ["direct", "pressed", "stuck"] },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["button", "touch", "dom", "tap-anywhere", "screenshot"] },
              "text": { "type": "string" },
              "afterMs": { "type": "number" }
            }
          }
        }
      }
    },
    "score": { "type": "object", "description": "Written by report/analyze.js." },
    "cocosAdvice": { "type": "object", "description": "Written by report/analyze.js." },
    "fps": { "type": "array", "description": "Written by report/analyze.js. One row per stage group: fps, fpsLow (1% low), badShare, level." },
    "todo": { "type": "array", "description": "Written by report/analyze.js. issues plus cocosAdvice items, worst first." },
    "conditions": { "type": "object" },
    "channels": { "type": "object" },
    "sceneLog": { "type": "array" },
    "stages": { "type": "array" },
    "spins": { "type": "array" },
    "memory": { "type": "object" },
    "findings": { "type": "array" },
    "coverage": { "type": "object" }
  }
}
